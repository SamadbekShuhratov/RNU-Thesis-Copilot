# Set these as environment variables (shell, Docker, systemd). They are defaults for the first start;
# after that the values saved in the portal → Settings (data/settings.json) take priority.
RNU_HOST=127.0.0.1
RNU_PORT=8765
RNU_LLM_PROVIDER=ollama            # ollama | openai_compatible | mock
RNU_LLM_BASE_URL=http://localhost:11434
RNU_LLM_MODEL=qwen2.5:14b-instruct
RNU_OPENALEX_MAILTO=
# RNU_DATA_DIR=./data
